# openccu-lite: the journal to the remote syslog host from /etc/config/syslog (LOGHOST).
#
# ExecCondition rather than ExecStartPre: a box with no LOGHOST set - which is nearly all of them -
# should leave this unit inactive rather than failed. occu-cron-backup.service used the same
# construct for the same reason. A LOGHOST changed on the Log page restarts this unit.
#
# `occulited syslog-forward` reads the journal with journalctl -f and sends every entry -
# syslog, stdout, native and kernel alike - as RFC 5424 over UDP, port 514 unless LOGHOST names one.
# It binds no socket of journald's; busybox syslogd, which did, took /dev/log away from journald.
#
# It needs the journal (the systemd-journal group) and the network, and nothing else: its own
# dynamic user, a read-only system. The journal cursor it keeps in its RuntimeDirectory lasts
# until the reboot (Preserve=yes), so a restart continues after the last entry sent instead of
# sending the last minutes again.
#
# journalctl -f reads the journal directories it found when it started: /run/log/journal, and
# below /var/log/journal the directory of the machine ID of that moment. Whatever moves the
# journal on the userfs while it runs leaves the forwarder active and silent, so both that do
# restart it once they are done: lite-journal-persist, when it mounts the userfs over
# /var/log/journal and has journald flush onto it, and lite-machine-id, when the boot that derives
# the machine ID restarts journald on it and moves the files (every boot that restores a backup on
# a system without a radio module's serial). After=occu-persist.service says what the network's
# own ordering already gave: at boot the journal is where it stays before this starts.
# The forwarder also notices a move by itself - the machine ID or a mount over a journal root
# changed - and starts journalctl again after the last entry sent, within about 10 s; the two
# restarts stay, as the cure that needs no wait. Every start logs the first entry it sends, so a
# forwarder that went quiet shows in the journal by the line it lacks.
#
# A reboot: the lines logged just before it are the ones a remote log is for. A stop sends what
# the journal has after the last entry sent, within 3 s (TimeoutStopSec leaves room for that), and
# writes the cursor of the last entry sent to the userfs (OCCU_SYSLOG_BOOT_CURSOR). The next boot
# sends the previous boot's entries after it - what the shutdown logged after the stop, once -
# when the journal still has that boot (persistent), then its own. The forwarder removes the file
# with its first entry sent, so a power loss leaves none and nothing is sent twice. Written once
# per stop, never while entries flow: the userfs may be an SD card. Its directory belongs to the
# systemd-journal group (setgid), as the dynamic user's uid may differ from boot to boot; the
# ExecStartPre (as root) makes it. KillMode=mixed: the stop's SIGTERM goes to the forwarder alone,
# not to its journalctl, so the forwarder ends that itself and drains instead of seeing it die.
[Unit]
Description=Forward the journal to a remote syslog host
After=network-online.target local-fs.target systemd-journald.service occu-persist.service
Wants=network-online.target

[Service]
Type=exec
ExecCondition=/bin/sh -c '[ -r /etc/config/syslog ] && . /etc/config/syslog && [ -n "$${LOGHOST:-}" ]'
ExecStartPre=+/bin/sh -c 'mkdir -p /usr/local/var/occu-syslog-forward && chown root:systemd-journal /usr/local/var/occu-syslog-forward && chmod 2770 /usr/local/var/occu-syslog-forward'
ExecStart=/usr/libexec/occu/lite-syslog-forward
Environment=OCCU_SYSLOG_BOOT_CURSOR=/usr/local/var/occu-syslog-forward/cursor
ReadWritePaths=-/usr/local/var/occu-syslog-forward
TimeoutStopSec=10
KillMode=mixed
# journalctl ending or an unusable LOGHOST is a failure and comes back; a clean stop is not
Restart=on-failure
RestartSec=5
DynamicUser=yes
SupplementaryGroups=systemd-journal
RuntimeDirectory=occu-syslog-forward
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
StandardOutput=journal
StandardError=journal
SyslogIdentifier=occu-syslog-forward

[Install]
WantedBy=multi-user.target
