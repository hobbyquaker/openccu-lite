# openccu-lite: replaces /etc/init.d/S40network. The script runs unchanged; the
# cgroup keeps whatever it starts (KillMode=control-group), so stop and status are systemd's.
# ifup -a runs /etc/network/if-up.d/eQ3StartNetwork (hostname, DHCP or static; the firewall and the
# internet check only where an image still has /bin/setfirewall.tcl and /bin/checkInternet, which
# this one does not);
# udhcpc stays in this cgroup. No networkd. Not after the CA bundle: bringing up a link and DHCP
# need none, and the bundle orders itself before the units that use it (ca-certificates.service).
# After S06InitSystem, as S40 came after S06: S06 creates /var/etc on the /var tmpfs, and the DHCP
# hook's resolvconf writes /var/etc/resolv.conf. A lease that came before it (a fast DHCP server
# while the journal's move to the userfs held S06 back) found no /var/etc, so the box had no
# resolver and no DNS, and chrony could not resolve its servers.
# After occu-firewall.service: the rules are loaded before any interface comes up,
# whatever /var/hm_mode says - the edge on S01InitHost, which the hook's HM_MODE test needed, is
# not needed any more (the firewall left the hook).
# Reload: a new DHCP lease under the current host name (lite-network-reload). occulited asks for it
# after a rename, so the DHCP server and the router's DNS learn the new name without a reboot; the
# client stays in this cgroup. A static setup has nothing to tell and the reload does nothing.
# Before the start, a fresh install's netconfig gets its host name (lite-default-hostname):
# openccu-lite-<the last four hex digits of eth0's MAC>, only where HOSTNAME is still empty, as
# openccu-lite's netconfig template leaves it.
[Unit]
Description=Network
After=occu-firewall.service occu-init-system.service
Before=network.target network-online.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/libexec/occu/lite-psplash boot S40network
ExecStartPre=-/usr/libexec/occu/lite-default-hostname
ExecStart=/etc/init.d/S40network.script start
ExecStartPost=-/usr/libexec/occu/lite-psplash done S40network
ExecStop=/etc/init.d/S40network.script stop
ExecReload=/usr/libexec/occu/lite-network-reload
KillMode=control-group
UMask=0002
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
