# openccu-lite: replaces the crontab.root line
#   1 3,9,15,21 * * * [ ! -e /usr/local/HMLGW ] && /bin/SetInterfaceClock
# Timers are wanted by multi-user.target and carry no default dependencies: the implicit
# Before=timers.target (part of basic.target) would form a cycle with After=occu-persist.service,
# which puts the stamp directory on the userfs and is itself after basic.target.
[Unit]
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
Description=Interface clock (four times a day)
After=occu-persist.service

[Timer]
OnCalendar=*-*-* 03,09,15,21:01:00
RandomizedDelaySec=5min
Persistent=false

[Install]
WantedBy=multi-user.target
