# openccu-lite: replaces /etc/init.d/S01InitZRAMSwap. The script runs unchanged; the
# cgroup keeps whatever it starts (KillMode=control-group), so stop and status are systemd's.
#
# Not at a shutdown: the swap needs no removal at a poweroff (systemd-shutdown turns every swap off
# at its end), and the script's hot_remove right after swapoff raced udev's change event for the
# device ("zram1: Failed to process device, ignoring: Device or resource busy" at every shutdown).
# A stop while the system runs removes it as before.
[Unit]
Description=ZRAM swap
After=occu-init-host.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/libexec/occu/lite-psplash boot S01InitZRAMSwap
ExecStart=/etc/init.d/S01InitZRAMSwap.script start
ExecStartPost=-/usr/libexec/occu/lite-psplash done S01InitZRAMSwap
ExecStop=/bin/sh -c '[ "$$(systemctl is-system-running)" = stopping ] || exec /etc/init.d/S01InitZRAMSwap.script stop'
KillMode=control-group
UMask=0002
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
