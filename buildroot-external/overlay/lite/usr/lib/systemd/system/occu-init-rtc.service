# openccu-lite: replaces /etc/init.d/S02InitRTC. The script runs unchanged; the
# cgroup keeps whatever it starts (KillMode=control-group), so stop and status are systemd's.
[Unit]
Description=Real-time clock
# After S01InitHost only: both rewrite /var/hm_mode, the one ordering that matters (the hm_mode race
# of 2026-09-09). The other S01 scripts (ZRAM swap, the USB gadget) never touch that file and run
# beside it.
After=occu-init-host.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/libexec/occu/lite-psplash boot S02InitRTC
ExecStart=/etc/init.d/S02InitRTC.script start
ExecStartPost=-/usr/libexec/occu/lite-psplash done S02InitRTC
ExecStop=/etc/init.d/S02InitRTC.script stop
KillMode=control-group
UMask=0002
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
