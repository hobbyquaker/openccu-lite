# openccu-lite: replaces /etc/init.d/S05CheckBackupRestore. The script runs unchanged; the
# cgroup keeps whatever it starts (KillMode=control-group), so stop and status are systemd's.
[Unit]
Description=Backup restore at boot
After=occu-factory-reset.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/libexec/occu/lite-psplash boot S05CheckBackupRestore
ExecStart=/etc/init.d/S05CheckBackupRestore.script start
ExecStartPost=-/usr/libexec/occu/lite-psplash done S05CheckBackupRestore
ExecStop=/etc/init.d/S05CheckBackupRestore.script stop
KillMode=control-group
UMask=0002
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
