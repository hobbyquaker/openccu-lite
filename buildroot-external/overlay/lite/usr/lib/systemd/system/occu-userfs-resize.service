# openccu-lite: replaces /etc/init.d/S03CheckUserFSResize. The script runs unchanged; the
# cgroup keeps whatever it starts (KillMode=control-group), so stop and status are systemd's.
# The script unmounts and remounts /usr/local; every unit here orders itself with After= only,
# never Requires=/RequiresMountsFor=, so the mount going away briefly stops nothing.
[Unit]
Description=Userfs resize
# S03 after S01 directly too: the LXC product drops occu-init-rtc (no hardware clock) and the chain
# must not split there (2026-09-09)
After=occu-init-rtc.service occu-init-host.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/libexec/occu/lite-psplash boot S03CheckUserFSResize
ExecStart=/etc/init.d/S03CheckUserFSResize.script start
ExecStartPost=-/usr/libexec/occu/lite-psplash done S03CheckUserFSResize
ExecStop=/etc/init.d/S03CheckUserFSResize.script stop
KillMode=control-group
UMask=0002
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
