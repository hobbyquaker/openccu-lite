#!/bin/sh
# openccu-lite (B-249): bring back a LAN9514 that did not come up after a warm reboot.
#
# On a Raspberry Pi 2/3 Model B the USB hub and the Ethernet controller are one chip (the LAN9514;
# on the 3 B+ its LAN7515 sibling) behind the SoC's only USB port. After a warm reboot the SoC
# resets but the chip stays powered, and now and then it did not answer the next USB bus reset:
# no hub, no Ethernet, no USB stick until a power cycle.
#
# Since upstream's #4596 the kernel resets the chip itself: onboard_usb_dev pulses its reset input
# LAN_RUN (reset-gpios on the hub's device-tree node) at every boot, of the system and of the
# recovery, and holds the line from then on. This script is the fallback behind it and no longer
# touches LAN_RUN (it could not: the line is the kernel's). occu-network.service needs eth0, so
# this runs before it: when no hub of vendor 0424 is at 1-1 (after a short grace for a slow
# enumeration), it switches the host port's power off and on (dwc_otg's buspower; with dwc2 an
# unbind and bind), waits for the hub and for eth0 and writes what happened to the journal and to
# /run/lite-lan-reset (key=value, for occulited's boot record). It acts only on a board whose
# device-tree model is a Raspberry Pi 2 or 3 Model B, and only when the hub is missing. Never fails
# the unit.
#
# LITE_ROOT prefixes every path, for scripts/testcases/lite-lan-reset-test.sh; LAN_RESET_GRACE,
# LAN_RESET_HUB_WAIT and LAN_RESET_ETH_WAIT (in tenths of a second) shorten the waits there.

R=${LITE_ROOT:-}
GRACE=${LAN_RESET_GRACE:-50}       # the hub may still be enumerating: 5 s
HUB_WAIT=${LAN_RESET_HUB_WAIT:-100} # after the reset: 10 s for the hub
ETH_WAIT=${LAN_RESET_ETH_WAIT:-200} # and 20 s for eth0 (smsc95xx is a module udev loads)
MARK="${R}/run/lite-lan-reset"

say() { echo "lan reset: $*"; }
wr() { # <value> <file>
  echo "$1" >"$2" 2>/dev/null
}
mark() { # key=value lines
  printf '%s\n' "$@" >"${MARK}.tmp" && mv -f "${MARK}.tmp" "$MARK"
}

model=$(tr -d '\000' <"${R}/proc/device-tree/model" 2>/dev/null)
case "$model" in
  "Raspberry Pi 3 Model B"*|"Raspberry Pi 2 Model B"*) ;;
  *) exit 0 ;;  # no LAN9514 on this board
esac

hub_present() {
  [ "$(cat "${R}/sys/bus/usb/devices/1-1/idVendor" 2>/dev/null)" = "0424" ]
}
wait_for() { # <tenths> <test command...>: 0 when the test passed in time; prints the tenths taken
  n=0; max=$1; shift
  while ! "$@"; do
    [ "$n" -ge "$max" ] && { echo "$n"; return 1; }
    sleep 0.1
    n=$((n + 1))
  done
  echo "$n"
}
eth_present() { [ -e "${R}/sys/class/net/eth0" ]; }

if t=$(wait_for "$GRACE" hub_present); then
  mark "result=present" "model=$model"
  [ "$t" -gt 0 ] && say "LAN9514 hub present after $((t * 100)) ms"
  exit 0
fi

say "no LAN9514 hub at USB 1-1 $((GRACE / 10)) s into the network start ($model) - re-powering the USB port"

# the host port: power off and on, so the core resets the bus and enumerates again
ctl=""
for f in "${R}"/sys/devices/platform/soc/*.usb/buspower; do
  [ -e "$f" ] || continue
  ctl="dwc_otg ${f%/buspower}"
  wr 0 "$f"; sleep 1; wr 1 "$f"
  break
done
if [ -z "$ctl" ]; then
  for d in "${R}"/sys/bus/platform/drivers/dwc2/*.usb; do
    [ -e "$d" ] || continue
    dev=${d##*/}
    ctl="dwc2 $dev"
    wr "$dev" "${R}/sys/bus/platform/drivers/dwc2/unbind"; sleep 1
    wr "$dev" "${R}/sys/bus/platform/drivers/dwc2/bind"
    break
  done
fi
if [ -n "$ctl" ]; then
  say "USB host port re-powered (${ctl%% *})"
else
  say "no dwc_otg or dwc2 controller found - no bus reset"
fi

if t=$(wait_for "$HUB_WAIT" hub_present); then
  hub_ms=$((t * 100))
  if e=$(wait_for "$ETH_WAIT" eth_present); then
    say "LAN9514 back: hub after ${hub_ms} ms, eth0 after $((e * 100)) ms more"
    mark "result=recovered" "model=$model" "controller=${ctl%% *}" \
      "hub_after_ms=$hub_ms" "eth0_after_ms=$((e * 100))"
  else
    say "LAN9514 hub back after ${hub_ms} ms, but no eth0 within $((ETH_WAIT / 10)) s"
    mark "result=hub-only" "model=$model" "controller=${ctl%% *}" \
      "hub_after_ms=$hub_ms"
  fi
else
  say "LAN9514 still missing $((HUB_WAIT / 10)) s after the reset - Ethernet and USB need a power cycle"
  mark "result=failed" "model=$model" "controller=${ctl%% *}"
fi
exit 0
