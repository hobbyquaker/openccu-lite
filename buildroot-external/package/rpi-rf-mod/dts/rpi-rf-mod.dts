/dts-v1/;
/plugin/;

/*
** Device Tree Overlay for eQ-3 RPI-RF-MOD and
** HM-MOD-RPI-PCB for RaspberryPi
**
** Copyright (c) 2018-2023 Jens Maus <mail@jens-maus.de>
** Licensed under Apache 2.0
**
*/

/ {
    compatible = "brcm,bcm2708";

    // fragment to ensure we have the correct gpio pin
    // setup for the RPI-RF-MOD
    fragment@0 {
        target = <&gpio>;
        __overlay__ {
            rpi_rf_mod_pins: rpi_rf_mod_pins {
                brcm,pins = <19 18 12 16 20 21>; // 19=reset, 18=reset (HM-MOD), 12=button, 16=red, 20=green, 21=blue
                brcm,pull = <0 0 2 0 0 0>; // 19,18=no-pullup, 12=pullup, 16,20,21=no-pullup
                brcm,function = <0 0 0 1 1 1>; // 19,18,12=input, 16,20,21=output
            };
        };
    };

    // fragment to keep the pin setup on the base leds node, where upstream's
    // overlay puts it (the reset lines and the button are inputs, the LED
    // pins outputs); the three LEDs themselves are the pwm-leds below
    fragment@1 {
        target = <&leds>;
        __overlay__ {
            pinctrl-names = "default";
            pinctrl-0 = <&rpi_rf_mod_pins>;
        };
    };

    // openccu-lite (task 315): the RPI-RF-MOD's RGB LED as three pwm-leds over
    // the kernel's software PWM (pwm-gpio, one hrtimer per channel) instead of
    // gpio-leds - 256 levels per channel for colour mixing and dimming, the
    // pattern trigger's fades and animations in the kernel. The labels, and so
    // the sysfs names rpi_rf_mod:red/green/blue, are upstream's: every writer
    // of triggers keeps working; only max_brightness is 255 instead of 1.
    // Period 4 ms (250 Hz). default-state "on" for red and green: the LED shows
    // the boot's yellow from the driver's probe on (and "keep" cannot work on
    // pwm-gpio, which has no state to read before its first apply).
    fragment@5 {
        target-path = "/";
        __overlay__ {
            rpi_rf_mod_pwm_red: rpi_rf_mod_pwm_red {
                compatible = "pwm-gpio";
                #pwm-cells = <3>;
                gpios = <&gpio 16 0>;
            };
            rpi_rf_mod_pwm_green: rpi_rf_mod_pwm_green {
                compatible = "pwm-gpio";
                #pwm-cells = <3>;
                gpios = <&gpio 20 0>;
            };
            rpi_rf_mod_pwm_blue: rpi_rf_mod_pwm_blue {
                compatible = "pwm-gpio";
                #pwm-cells = <3>;
                gpios = <&gpio 21 0>;
            };
            rpi_rf_mod_leds: rpi_rf_mod_leds {
                compatible = "pwm-leds";
                rpi_rf_mod_red: led-red {
                    label = "rpi_rf_mod:red";
                    pwms = <&rpi_rf_mod_pwm_red 0 4000000 0>;
                    max-brightness = <255>;
                    default-state = "on";
                    linux,default-trigger = "none";
                };
                rpi_rf_mod_green: led-green {
                    label = "rpi_rf_mod:green";
                    pwms = <&rpi_rf_mod_pwm_green 0 4000000 0>;
                    max-brightness = <255>;
                    default-state = "on";
                    linux,default-trigger = "none";
                };
                rpi_rf_mod_blue: led-blue {
                    label = "rpi_rf_mod:blue";
                    pwms = <&rpi_rf_mod_pwm_blue 0 4000000 0>;
                    max-brightness = <255>;
                    default-state = "off";
                    linux,default-trigger = "none";
                };
            };
        };
    };

    // fragment to define settings for the rx8130 RTC clock
    // of the RPI-RF-MOD
    fragment@2 {
        target = <&i2c1>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";

            rpi_rf_mod_rtc: rx8130@32 {
                compatible = "epson,rx8130";
                reg = <0x32>;
                status = "okay";
                aux-voltage-chargeable = <1>;
            };
        };
    };

    // fragment to define uart/serial dependencies for
    // generic_raw_uart
    fragment@3 {
        target = <&uart0>;
        __overlay__ {
            compatible = "pivccu,pl011";
            status = "okay";
            pivccu,reset-gpios = <&gpio 18 0>, <&gpio 19 0>; // HM-MOD-RPI-PCB, RPI-RF-MOD
            pivccu,led-gpios = <&gpio 16 0>, <&gpio 20 0>, <&gpio 21 0>; // RPI-RF-MOD
            pivccu,rtc = <&rpi_rf_mod_rtc>;       // RPI-RF-MOD
        };
    };

    // fragment to make sure that stdout-path under chosen
    // is empty so that the above uart0 fragment does not
    // interfere with u-boot trying to access serial drivers.
    fragment@4 {
        target = <&chosen>;
        __overlay__ {
            stdout-path = "";
        };
    };
};
