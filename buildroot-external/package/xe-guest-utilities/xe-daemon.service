# xe-guest-utilities: the XenServer guest agent (S11xe-daemon's twin). Only on Xen: the
# condition keeps it inert on every other hypervisor and on bare metal.
[Unit]
Description=XenServer guest agent (xe-daemon)
ConditionPathExists=/proc/xen
After=proc-xen.mount network.target
Wants=proc-xen.mount

[Service]
Type=simple
ExecStartPre=/usr/sbin/xe-linux-distribution /var/cache/xe-linux-distribution
ExecStart=/usr/sbin/xe-daemon -p /run/xe-daemon.pid
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
