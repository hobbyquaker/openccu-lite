# openccu-lite: the x86_64 VM and appliance product (D-39, D-43, D-30). Derived from upstream's
# configs/ova.config: the same kernel, bootloader, packages and the D-23 reductions; the lite delta
# is the WebUI symbol off, package/occulited on, BR2_INIT_SYSTEMD with every systemd sub-option off
# (docs/systemd-scope.md says why for the ones that are on), udev from systemd instead of eudev,
# the lite + lite_ova overlays through board/lite/pre-build-systemd.sh (merged /usr).
# overlay/lite_ova is empty since 2026-09-07: it held only etc/inittab (busybox init, which a
# systemd product does not run) and etc/crontab.root (shadowed by what is now overlay/lite's,
# deliberately empty of system jobs because D-30 made them timers). It stays in both lists
# below - pre-build-systemd.sh skips a missing source overlay - so that ova-specific content
# added later is picked up without having to remember to re-add the overlay.
# and a kernel fragment with what systemd needs. PRODUCT/PLATFORM in /VERSION are rewritten to
# upstream's "ova" (D-31), because that is what the recovery compares on an in-place update.
# The busybox-init variant this was split from is not carried forward (D-39): systemd is the
# product.
BR2_x86_64=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_ROOTFS_LIB_DIR="lib"
BR2_ROOTFS_LIB32_DIR="lib32"
# merged-/usr copies of the overlays (board/lite/pre-build-systemd.sh): systemd selects
# BR2_ROOTFS_MERGED_USR and buildroot refuses an overlay with a real /bin or /lib, which
# upstream's have. The pre-build script rewrites them under $(BASE_DIR)/overlay-merged/.
# openccu-lite: the lite products' own package patches (lighttpd: a POST without a body is taken as
# an empty one, not 411). Only this directory: upstream's patches/ are not this product's.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_EQ3_PATH)/board/lite/patches"
BR2_ROOTFS_PRE_BUILD_SCRIPT="$(BR2_EXTERNAL_EQ3_PATH)/board/lite/pre-build-systemd.sh"
BR2_ROOTFS_PRE_BUILD_SCRIPT_ARGS="$(BR2_EXTERNAL_EQ3_PATH)/overlay/base $(BR2_EXTERNAL_EQ3_PATH)/overlay/base-openccu $(BR2_EXTERNAL_EQ3_PATH)/overlay/RFD $(BR2_EXTERNAL_EQ3_PATH)/overlay/lite $(BR2_EXTERNAL_EQ3_PATH)/overlay/lite_ova"
BR2_ROOTFS_OVERLAY="$(BASE_DIR)/overlay-merged/base $(BASE_DIR)/overlay-merged/base-openccu $(BASE_DIR)/overlay-merged/RFD $(BASE_DIR)/overlay-merged/lite $(BASE_DIR)/overlay-merged/lite_ova"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_EQ3_PATH)/board/post-build.sh $(BR2_EXTERNAL_EQ3_PATH)/board/ova/post-build.sh $(BR2_EXTERNAL_EQ3_PATH)/board/lite/post-build.sh $(BR2_EXTERNAL_EQ3_PATH)/board/lite/post-build-systemd.sh $(BR2_EXTERNAL_EQ3_PATH)/board/lite/post-build-sbom.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_EQ3_PATH)/board/ova/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.51"
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/global.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/device-support.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/device-support-pci.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/security-x86_64.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/security.config $(BR2_EXTERNAL_EQ3_PATH)/board/ova/kernel.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/lite.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/lite-systemd.config"
BR2_LINUX_KERNEL_LZ4=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_PACKAGE_LINUX_TOOLS_GPIO=y
BR2_PACKAGE_LINUX_TOOLS_HV=y
BR2_PACKAGE_LINUX_TOOLS_HV_KVP_DAEMON=y
BR2_PACKAGE_LINUX_TOOLS_HV_FCOPY_DAEMON=y
BR2_PACKAGE_LINUX_TOOLS_HV_VSS_DAEMON=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_E4DEFRAG=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_EXFAT=y
BR2_PACKAGE_EXFAT_UTILS=y
BR2_PACKAGE_F2FS_TOOLS=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_PSPLASH=y
BR2_PACKAGE_PSPLASH_IMAGE="$(BR2_EXTERNAL_EQ3_PATH)/board/lite/psplash/logo.png"
BR2_PACKAGE_ACPID=y
BR2_PACKAGE_DMIDECODE=y
BR2_PACKAGE_PARTED=y
# No smartmontools (task 111): a VM's disks are the host's, and so is watching their health - the
# Status page says so. smartd is on no lite product; board/lite/no-smartd.sh.
# BR2_PACKAGE_SMARTMONTOOLS is not set
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_UBOOT_TOOLS_MKIMAGE=y
BR2_PACKAGE_UBOOT_TOOLS_MKENVIMAGE=y
BR2_PACKAGE_UBOOT_TOOLS_DUMPIMAGE=y
BR2_PACKAGE_USBMOUNT=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_QEMU_GUEST_AGENT=y
# board/ova/post-image.sh converts the image with $(HOST_DIR)/bin/qemu-img; upstream gets
# host-qemu only as a side effect of nodejs (package/nodejs selects it), which the lite
# products do not build. No emulation mode: host-qemu then builds the tools alone.
BR2_PACKAGE_HOST_QEMU=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_IFPLUGD=y
BR2_PACKAGE_OPENVMTOOLS=y
BR2_PACKAGE_UTIL_LINUX_ZRAMCTL=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS=""
BR2_TARGET_ROOTFS_EXT2_RESBLKS=0
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat squash4 part_msdos part_gpt normal biosdisk search test"
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_MULTILIB32=y
BR2_PACKAGE_MULTILIB32_CONFIG_FRAGMENT_FILE="multilib32_i686.config"
BR2_PACKAGE_RECOVERY_SYSTEM=y
BR2_PACKAGE_RECOVERY_SYSTEM_CONFIG_FRAGMENT_FILE="recovery_ova.config"
BR2_PACKAGE_RPI_RF_MOD=y
BR2_PACKAGE_XE_GUEST_UTILITIES=y
BR2_PACKAGE_IRQBALANCE=y

#
# No CCU WebUI and no ReGaHss (D-1): the two options of package/openccu-base
# (OpenCCU/OpenCCU#4183) off. The Tcl homematic package, tclrpc.so, the device
# types and the firmware stay; /www/rega/licenseinfo.htm stays too. tclrega.so
# is package/occulited's shim instead of upstream's.
#
# BR2_PACKAGE_OPENCCU_BASE_REGAHSS is not set
# BR2_PACKAGE_OPENCCU_BASE_WEBUI is not set

#
# The system service, its lighttpd wiring (mod_magnet for the addon-page
# gate) and the tclrega.so shim from package/occulited. The upstream
# tclrega talks to ReGaHss on 8183 and is left out with REGAHSS above.
#
BR2_PACKAGE_OCCULITED=y
# openccu-lite (task 147): the HM-CFG-USB-2's firmware flasher
BR2_PACKAGE_HMCFGUSB=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LIGHTTPD_LUA=y

#
# Base system reduced to CCU3 scope (D-23). Nothing below is on a stock
# CCU3 and nothing in the Homematic stack needs it. Everything
# radio-related is untouched (D-26).
#
# BR2_PACKAGE_AVAHI is not set
# ntpdate: chronyd sets the clock on lite (lite-chrony) and nothing calls ntpdate; the
# shared Buildroot.config builds it for the upstream products and the recovery system
# BR2_PACKAGE_NTP is not set
# BR2_PACKAGE_CLOUDMATIC is not set
# BR2_PACKAGE_LOGROTATE is not set
# BR2_PACKAGE_MONIT is not set
# BR2_PACKAGE_MSMTP is not set
# BR2_PACKAGE_NEOSERVER is not set
# BR2_PACKAGE_NETSNMP is not set
# BR2_PACKAGE_NMAP is not set
# BR2_PACKAGE_NODEJS is not set
# BR2_PACKAGE_NODEJS_NPM is not set
# BR2_PACKAGE_NUT is not set
# BR2_PACKAGE_OPENVPN is not set
# openccu-lite task 86 (D-64, D-65): the backup targets' NFS and SMB shares, a D-23 exception.
# cifs-utils for mount.cifs, whose credentials file keeps the password off every command line;
# nfs-utils for mount.nfs (names, v3 negotiation, readable errors), as a client only - no NFS
# server, and no NFSv4 extras (nfsidmap, gssd, blkmapd pull keyutils and lvm2; mount.nfs mounts
# v4 with vers= without them)
BR2_PACKAGE_CIFS_UTILS=y
BR2_PACKAGE_NFS_UTILS=y
# BR2_PACKAGE_NFS_UTILS_RPC_NFSD is not set
BR2_PACKAGE_RSYNC=y
# BR2_PACKAGE_SER2NET is not set
# BR2_PACKAGE_SOCAT is not set
# BR2_PACKAGE_STRACE is not set
# BR2_PACKAGE_TAILSCALE_BIN is not set
# BR2_PACKAGE_TCPDUMP is not set
# BR2_PACKAGE_WIREGUARD_TOOLS is not set
# BR2_PACKAGE_XINETD is not set

#
# D-34 (openccu-lite docs/base-scope.md): ICU, fontconfig and the DejaVu/Liberation fonts are
# only referenced by java-azul (hmipserver); they are meant to go, but java-azul.mk lists
# fontconfig/dejavu/liberation unconditionally in _DEPENDENCIES and kconfig refuses a config
# that does not select them. Removal waits for a conditional-dependency change in
# package/java-azul (upstreamable) plus a measurement of hmipserver without them; until then
# they stay in, exactly as upstream builds them.
# BR2_PACKAGE_DAEMONIZE is not set

#
# systemd as init (D-30): PID 1, journald and udevd (systemd-udevd replaces eudev) and nothing
# else from the suite. Every sub-option is off; docs/systemd-scope.md in this fork records the
# reason for anything that is turned on later. logind, resolved, timesyncd (chrony stays),
# hostnamed, timedated, localed, machined, importd, homed, coredump, pstore, firstboot, polkit,
# hwdb, boot and networkd (ifupdown/eQ3StartNetwork stay) are the ones D-30 names explicitly.
#
BR2_INIT_SYSTEMD=y
# task 121: systemd with libseccomp (buildroot builds it with -Dseccomp=enabled when the library
# is selected), so SystemCallFilter=, RestrictAddressFamilies=, RestrictNamespaces=,
# RestrictSUIDSGID=, LockPersonality=, MemoryDenyWriteExecute=, RestrictRealtime= and
# SystemCallArchitectures= of the lite units and of occulited's addon drop-in are enforced
BR2_PACKAGE_LIBSECCOMP=y
# hmipserver's port 39292 on the loopback: the LD_PRELOAD shim its unit loads
BR2_PACKAGE_LITE_BINDLO=y
# BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV is not set
# BR2_PACKAGE_SYSTEMD_BOOT is not set
# BR2_PACKAGE_SYSTEMD_INITRD is not set
# BR2_PACKAGE_SYSTEMD_KERNELINSTALL is not set
BR2_PACKAGE_SYSTEMD_ANALYZE=y
# BR2_PACKAGE_SYSTEMD_EFI is not set
# BR2_PACKAGE_SYSTEMD_JOURNAL_REMOTE is not set
# BR2_PACKAGE_SYSTEMD_BACKLIGHT is not set
# BR2_PACKAGE_SYSTEMD_BINFMT is not set
# BR2_PACKAGE_SYSTEMD_COREDUMP is not set
# BR2_PACKAGE_SYSTEMD_PSTORE is not set
# BR2_PACKAGE_SYSTEMD_FIRSTBOOT is not set
# BR2_PACKAGE_SYSTEMD_HIBERNATE is not set
# BR2_PACKAGE_SYSTEMD_HOMED is not set
# BR2_PACKAGE_SYSTEMD_HOSTNAMED is not set
# BR2_PACKAGE_SYSTEMD_HWDB is not set
# BR2_PACKAGE_SYSTEMD_IMPORTD is not set
# BR2_PACKAGE_SYSTEMD_CATALOGDB is not set
# BR2_PACKAGE_SYSTEMD_LOCALED is not set
# BR2_PACKAGE_SYSTEMD_LOGIND is not set
# BR2_PACKAGE_SYSTEMD_MACHINED is not set
# BR2_PACKAGE_SYSTEMD_NSPAWN is not set
# BR2_PACKAGE_SYSTEMD_NSRESOURCED is not set
# BR2_PACKAGE_SYSTEMD_MYHOSTNAME is not set
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# BR2_PACKAGE_SYSTEMD_OOMD is not set
# BR2_PACKAGE_SYSTEMD_POLKIT is not set
# BR2_PACKAGE_SYSTEMD_PORTABLED is not set
# BR2_PACKAGE_SYSTEMD_QUOTACHECK is not set
# BR2_PACKAGE_SYSTEMD_RANDOMSEED is not set
# BR2_PACKAGE_SYSTEMD_REPART is not set
# BR2_PACKAGE_SYSTEMD_RESOLVED is not set
# BR2_PACKAGE_SYSTEMD_RFKILL is not set
# BR2_PACKAGE_SYSTEMD_SMACK_SUPPORT is not set
# BR2_PACKAGE_SYSTEMD_SYSEXT is not set
# BR2_PACKAGE_SYSTEMD_MOUNTFSD is not set
# BR2_PACKAGE_SYSTEMD_SYSUPDATE is not set
# BR2_PACKAGE_SYSTEMD_SYSUSERS is not set
# BR2_PACKAGE_SYSTEMD_TIMEDATED is not set
# BR2_PACKAGE_SYSTEMD_TIMESYNCD is not set
# BR2_PACKAGE_SYSTEMD_USERDB is not set
# BR2_PACKAGE_SYSTEMD_UTMP is not set
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set
# BR2_PACKAGE_SYSTEMD_VMSPAWN is not set
