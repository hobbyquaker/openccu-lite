# openccu-lite: the Raspberry Pi 5 / CM5 aarch64 product (task 32, D-43, D-31) - the third
# aarch64 board image. Derived from configs/rpi5.config exactly the way aarch64-rpi4.config was
# derived from rpi4.config: same kernel (bcm2712 defconfig, 16K pages, Cortex-A76), bootloader
# (u-boot 2026.04), device trees, board scripts and image layout; no rpi-firmware package, because
# the Pi 5 boots from its EEPROM (rpi-eeprom with the RPI5 variant). The lite delta is the WebUI
# symbol off, package/occulited on, the D-23 reductions, the lite overlay through
# board/lite/pre-build-systemd.sh (merged /usr), BR2_INIT_SYSTEMD with every systemd sub-option
# off, the kernel fragments kernel/6.18/lite.config + lite-systemd.config and the two lite
# post-build scripts. Everything board-specific stays in board/rpi5 (kernel.config, DTs, u-boot,
# boot.cmd, config.txt, genimage.cfg, post-image); board/aarch64-rpi5/post-release.sh is
# board/rpi4's lite copy with the D-44 names and release/updatepkg/aarch64-rpi5 the same update
# package. /VERSION is rewritten to PRODUCT=rpi5 PLATFORM=rpi5 by board/lite/post-build.sh,
# because that is what upstream's images say and what the recovery compares on an in-place update
# (D-31); VARIANT=lite and LITE=<n> identify the lite image. No BR2_PACKAGE_HOST_QEMU here -
# board/rpi5/post-image.sh builds the card image with genimage and mkfs.ext4, not qemu-img.
# Never booted on hardware: the RF module's UART on the Pi 5 (RP1), the watchdog, the LEDs and
# occu-interface-clock are checked on the board, not assumed (openccu-lite roadmap task 32).
BR2_aarch64=y
BR2_cortex_a76=y
BR2_ARM64_PAGE_SIZE_16K=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
# openccu-lite: board/lite/patches holds the lite products' own package patches (lighttpd: a POST
# without a body is taken as an empty one, not 411)
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_EQ3_PATH)/patches $(BR2_EXTERNAL_EQ3_PATH)/board/rpi5/patches $(BR2_EXTERNAL_EQ3_PATH)/board/lite/patches"
BR2_ROOTFS_LIB_DIR="lib"
BR2_ROOTFS_LIB32_DIR="lib32"
# merged-/usr copies of the overlays (board/lite/pre-build-systemd.sh): systemd selects
# BR2_ROOTFS_MERGED_USR and buildroot refuses an overlay with a real /bin or /lib, which
# upstream's have. The pre-build script rewrites them under $(BASE_DIR)/overlay-merged/.
BR2_ROOTFS_PRE_BUILD_SCRIPT="$(BR2_EXTERNAL_EQ3_PATH)/board/lite/pre-build-systemd.sh"
BR2_ROOTFS_PRE_BUILD_SCRIPT_ARGS="$(BR2_EXTERNAL_EQ3_PATH)/overlay/base $(BR2_EXTERNAL_EQ3_PATH)/overlay/base-openccu $(BR2_EXTERNAL_EQ3_PATH)/overlay/RFD $(BR2_EXTERNAL_EQ3_PATH)/overlay/lite"
BR2_ROOTFS_OVERLAY="$(BASE_DIR)/overlay-merged/base $(BASE_DIR)/overlay-merged/base-openccu $(BASE_DIR)/overlay-merged/RFD $(BASE_DIR)/overlay-merged/lite"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_EQ3_PATH)/board/post-build.sh $(BR2_EXTERNAL_EQ3_PATH)/board/rpi5/post-build.sh $(BR2_EXTERNAL_EQ3_PATH)/board/lite/post-build.sh $(BR2_EXTERNAL_EQ3_PATH)/board/lite/post-build-systemd.sh $(BR2_EXTERNAL_EQ3_PATH)/board/lite/post-build-sbom.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_EQ3_PATH)/board/rpi5/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/raspberrypi/linux/archive/stable_20260609.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/global.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/device-support.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/security-arm64.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/security.config $(BR2_EXTERNAL_EQ3_PATH)/board/rpi5/kernel.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/lite.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.18/lite-systemd.config"
BR2_LINUX_KERNEL_LZ4=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-rpi-500 broadcom/bcm2712-rpi-cm5-cm4io broadcom/bcm2712-rpi-cm5-cm5io broadcom/bcm2712-rpi-cm5l-cm4io broadcom/bcm2712-rpi-cm5l-cm5io"
BR2_LINUX_KERNEL_INSTALL_INTREE_OVERLAYS=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_LINUX_TOOLS_GPIO=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_E4DEFRAG=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_EXFAT=y
BR2_PACKAGE_EXFAT_UTILS=y
BR2_PACKAGE_F2FS_TOOLS=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_PSPLASH=y
BR2_PACKAGE_PSPLASH_IMAGE="$(BR2_EXTERNAL_EQ3_PATH)/board/lite/psplash/logo.png"
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
# BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT is not set
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_COMPRESS=y
BR2_PACKAGE_LINUX_FIRMWARE_COMPRESS_ZSTD=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT61=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT73=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_VCGENCMD=y
BR2_PACKAGE_SMARTMONTOOLS=y
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_UBOOT_TOOLS_MKIMAGE=y
BR2_PACKAGE_UBOOT_TOOLS_MKENVIMAGE=y
BR2_PACKAGE_UBOOT_TOOLS_DUMPIMAGE=y
BR2_PACKAGE_USB_MODESWITCH_DATA=y
BR2_PACKAGE_USBMOUNT=y
BR2_PACKAGE_DTC=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
# BR2_PACKAGE_BLUEZ5_UTILS is not set
# BlueZ selected ncurses and readline, and util-linux (fdisk, sfdisk, cfdisk, lsblk, dmesg,
# hexdump), parted, partprobe, wpa_cli and irqbalance are built against them: they stay, on their own.
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_READLINE=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_IFPLUGD=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_WEXT=y
BR2_PACKAGE_WPA_SUPPLICANT_WIRED=y
BR2_PACKAGE_WPA_SUPPLICANT_IBSS_RSN=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_WIFI_DISPLAY=y
BR2_PACKAGE_WPA_SUPPLICANT_MESH_NETWORKING=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
BR2_PACKAGE_WPA_SUPPLICANT_HOTSPOT=y
BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
BR2_PACKAGE_WPA_SUPPLICANT_WPS=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS_INTROSPECTION=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_UTIL_LINUX_ZRAMCTL=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS=""
BR2_TARGET_ROOTFS_EXT2_RESBLKS=0
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.04"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rpi_arm64"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EQ3_PATH)/bootloader/uboot.config $(BR2_EXTERNAL_EQ3_PATH)/board/rpi5/uboot.config"
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT_SOURCE="$(BR2_EXTERNAL_EQ3_PATH)/board/rpi5/boot.cmd"
BR2_PACKAGE_MULTILIB32=y
BR2_PACKAGE_MULTILIB32_CONFIG_FRAGMENT_FILE="multilib32_arm_a76-16k.config"
BR2_PACKAGE_RECOVERY_SYSTEM=y
BR2_PACKAGE_RECOVERY_SYSTEM_CONFIG_FRAGMENT_FILE="recovery_rpi5.config"
BR2_PACKAGE_RPI_RF_MOD=y
BR2_PACKAGE_RPI_RF_MOD_DTS=y
BR2_PACKAGE_RPI_EEPROM=y
BR2_PACKAGE_RPI_EEPROM_RPI5=y
BR2_PACKAGE_IRQBALANCE=y

#
# No CCU WebUI and no ReGaHss (D-1): the two options of package/openccu-base
# (OpenCCU/OpenCCU#4183) off. The Tcl homematic package, tclrpc.so, the device
# types and the firmware stay; /www/rega/licenseinfo.htm stays too. tclrega.so
# is package/occulited's shim instead of upstream's.
#
# BR2_PACKAGE_OPENCCU_BASE_REGAHSS is not set
# BR2_PACKAGE_OPENCCU_BASE_WEBUI is not set

#
# The system service, its lighttpd wiring (mod_magnet for the addon-page
# gate) and the tclrega.so shim from package/occulited. The upstream
# tclrega talks to ReGaHss on 8183 and is left out with REGAHSS above.
#
BR2_PACKAGE_OCCULITED=y
# openccu-lite (task 147): the HM-CFG-USB-2's firmware flasher
BR2_PACKAGE_HMCFGUSB=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LIGHTTPD_LUA=y

#
# Base system reduced to CCU3 scope (D-23). Nothing below is on a stock
# CCU3 and nothing in the Homematic stack needs it. Everything
# radio-related is untouched (D-26).
#
# BR2_PACKAGE_AVAHI is not set
# ntpdate: chronyd sets the clock on lite (lite-chrony) and nothing calls ntpdate; the
# shared Buildroot.config builds it for the upstream products and the recovery system
# BR2_PACKAGE_NTP is not set
# BR2_PACKAGE_CLOUDMATIC is not set
# BR2_PACKAGE_LOGROTATE is not set
# BR2_PACKAGE_MONIT is not set
# BR2_PACKAGE_MSMTP is not set
# BR2_PACKAGE_NEOSERVER is not set
# BR2_PACKAGE_NETSNMP is not set
# BR2_PACKAGE_NMAP is not set
# BR2_PACKAGE_NODEJS is not set
# BR2_PACKAGE_NODEJS_NPM is not set
# BR2_PACKAGE_NUT is not set
# BR2_PACKAGE_OPENVPN is not set
# openccu-lite task 86 (D-64, D-65): the backup targets' NFS and SMB shares, a D-23 exception.
# cifs-utils for mount.cifs, whose credentials file keeps the password off every command line;
# nfs-utils for mount.nfs (names, v3 negotiation, readable errors), as a client only - no NFS
# server, and no NFSv4 extras (nfsidmap, gssd, blkmapd pull keyutils and lvm2; mount.nfs mounts
# v4 with vers= without them)
BR2_PACKAGE_CIFS_UTILS=y
BR2_PACKAGE_NFS_UTILS=y
# BR2_PACKAGE_NFS_UTILS_RPC_NFSD is not set
BR2_PACKAGE_RSYNC=y
# BR2_PACKAGE_SER2NET is not set
# BR2_PACKAGE_SOCAT is not set
# BR2_PACKAGE_STRACE is not set
# BR2_PACKAGE_TAILSCALE_BIN is not set
# BR2_PACKAGE_TCPDUMP is not set
# BR2_PACKAGE_WIREGUARD_TOOLS is not set
# BR2_PACKAGE_XINETD is not set

#
# The per-board UPS, fan and display daemons D-23 names explicitly. None of them is on a CCU3
# or a plain Pi, each is a third-party HAT helper, and every one of them ships an /etc/init.d
# script only - systemd would not run them at all, so leaving them in would install six daemons
# that silently never start. raspi-fanshim depends on wiringpi, which goes with it.
#
# BR2_PACKAGE_SUSVD is not set
# BR2_PACKAGE_PIUSVD is not set
# BR2_PACKAGE_PICOD is not set
# BR2_PACKAGE_STROMPI2D is not set
# BR2_PACKAGE_PIDESKTOPD is not set
# BR2_PACKAGE_ARGONONED is not set
# BR2_PACKAGE_WIRINGPI_RPI is not set
# BR2_PACKAGE_RASPI_FANSHIM is not set
#
# The Wi-Fi stack of the upstream Pi defconfigs stays: unlike x86_64-ova (a VM has none) these
# boards have a real radio, and D-23's task-2 exception list keeps wpa_supplicant (to be trimmed
# hard later, not dropped). The Bluetooth stack goes (D-54, 2026-09-12): BlueZ and the Pi's
# Bluetooth firmware are off above - the radio module takes the UART Bluetooth would use, and
# nothing on the box speaks Bluetooth.

#
# D-34 (openccu-lite docs/base-scope.md): ICU, fontconfig and the DejaVu/Liberation fonts are
# only referenced by java-azul (hmipserver); they are meant to go, but java-azul.mk lists
# fontconfig/dejavu/liberation unconditionally in _DEPENDENCIES and kconfig refuses a config
# that does not select them. Removal waits for a conditional-dependency change in
# package/java-azul (upstreamable) plus a measurement of hmipserver without them; until then
# they stay in, exactly as upstream builds them.
# BR2_PACKAGE_DAEMONIZE is not set

#
# systemd as init (D-30): PID 1, journald and udevd (systemd-udevd replaces eudev) and nothing
# else from the suite. Every sub-option is off; docs/systemd-scope.md in this fork records the
# reason for anything that is turned on later. logind, resolved, timesyncd (chrony stays),
# hostnamed, timedated, localed, machined, importd, homed, coredump, pstore, firstboot, polkit,
# hwdb, boot and networkd (ifupdown/eQ3StartNetwork stay) are the ones D-30 names explicitly.
#
BR2_INIT_SYSTEMD=y
# task 121: systemd with libseccomp (buildroot builds it with -Dseccomp=enabled when the library
# is selected), so SystemCallFilter=, RestrictAddressFamilies=, RestrictNamespaces=,
# RestrictSUIDSGID=, LockPersonality=, MemoryDenyWriteExecute=, RestrictRealtime= and
# SystemCallArchitectures= of the lite units and of occulited's addon drop-in are enforced
BR2_PACKAGE_LIBSECCOMP=y
# hmipserver's port 39292 on the loopback: the LD_PRELOAD shim its unit loads
BR2_PACKAGE_LITE_BINDLO=y
# BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV is not set
# BR2_PACKAGE_SYSTEMD_BOOT is not set
# BR2_PACKAGE_SYSTEMD_INITRD is not set
# BR2_PACKAGE_SYSTEMD_KERNELINSTALL is not set
BR2_PACKAGE_SYSTEMD_ANALYZE=y
# BR2_PACKAGE_SYSTEMD_EFI is not set
# BR2_PACKAGE_SYSTEMD_JOURNAL_REMOTE is not set
# BR2_PACKAGE_SYSTEMD_BACKLIGHT is not set
# BR2_PACKAGE_SYSTEMD_BINFMT is not set
# BR2_PACKAGE_SYSTEMD_COREDUMP is not set
# BR2_PACKAGE_SYSTEMD_PSTORE is not set
# BR2_PACKAGE_SYSTEMD_FIRSTBOOT is not set
# BR2_PACKAGE_SYSTEMD_HIBERNATE is not set
# BR2_PACKAGE_SYSTEMD_HOMED is not set
# BR2_PACKAGE_SYSTEMD_HOSTNAMED is not set
# BR2_PACKAGE_SYSTEMD_HWDB is not set
# BR2_PACKAGE_SYSTEMD_IMPORTD is not set
# BR2_PACKAGE_SYSTEMD_CATALOGDB is not set
# BR2_PACKAGE_SYSTEMD_LOCALED is not set
# BR2_PACKAGE_SYSTEMD_LOGIND is not set
# BR2_PACKAGE_SYSTEMD_MACHINED is not set
# BR2_PACKAGE_SYSTEMD_NSPAWN is not set
# BR2_PACKAGE_SYSTEMD_NSRESOURCED is not set
# BR2_PACKAGE_SYSTEMD_MYHOSTNAME is not set
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# BR2_PACKAGE_SYSTEMD_OOMD is not set
# BR2_PACKAGE_SYSTEMD_POLKIT is not set
# BR2_PACKAGE_SYSTEMD_PORTABLED is not set
# BR2_PACKAGE_SYSTEMD_QUOTACHECK is not set
# BR2_PACKAGE_SYSTEMD_RANDOMSEED is not set
# BR2_PACKAGE_SYSTEMD_REPART is not set
# BR2_PACKAGE_SYSTEMD_RESOLVED is not set
# BR2_PACKAGE_SYSTEMD_RFKILL is not set
# BR2_PACKAGE_SYSTEMD_SMACK_SUPPORT is not set
# BR2_PACKAGE_SYSTEMD_SYSEXT is not set
# BR2_PACKAGE_SYSTEMD_MOUNTFSD is not set
# BR2_PACKAGE_SYSTEMD_SYSUPDATE is not set
# BR2_PACKAGE_SYSTEMD_SYSUSERS is not set
# BR2_PACKAGE_SYSTEMD_TIMEDATED is not set
# BR2_PACKAGE_SYSTEMD_TIMESYNCD is not set
# BR2_PACKAGE_SYSTEMD_USERDB is not set
# BR2_PACKAGE_SYSTEMD_UTMP is not set
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set
# BR2_PACKAGE_SYSTEMD_VMSPAWN is not set
