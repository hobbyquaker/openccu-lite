# openccu-lite (D-33): what tasks 17/18/20 need from the kernel on top of upstream's
# security.config (which already has seccomp, the LSM list and AppArmor): namespaces for
# per-addon confinement and for systemd's DynamicUser=/PrivateTmp=, cgroups for unit accounting.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
# overlayfs: the writable extension directories for addons (occu-extension-dirs.service) - the
# image's /firmware/rftypes as the lower layer, the addons' device descriptions in an upper layer
# on the userfs. Built in on every lite kernel: the x86_64 defconfig has no overlayfs at all, the
# Pi defconfigs a module that would have to be loaded first.
CONFIG_OVERLAY_FS=y
# openccu-lite task 86: NFS 4.1 and 4.2 for the backup targets on every product - one TCP connection
# to 2049 with the callback channel inside it, nothing inbound for the firewall to drop. The Pi
# defconfigs have them; the x86_64 one stops at 4.0.
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
