# openccu-lite (D-30): what systemd needs from the kernel, on top of lite.config (namespaces and
# cgroup controllers) and upstream's fragments. Buildroot's package/systemd enables the hard
# requirements itself when it builds the kernel; listing them here makes the product config
# self-describing and catches a fragment that turns one of them off again (global.config has
# "# CONFIG_AUTOFS_FS is not set").
CONFIG_DEVTMPFS=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
# multimacd raises its own real-time priority (sched_setscheduler) from inside a service cgroup;
# with RT group scheduling that needs a runtime allocation per cgroup, which nothing here does.
# CONFIG_RT_GROUP_SCHED is not set
